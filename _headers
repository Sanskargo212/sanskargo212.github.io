/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'none'; img-src 'self' data:; font-src data:; style-src 'unsafe-inline'; script-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'; upgrade-insecure-requests

# صفحه اصلی: کش کوتاه در مرورگر، ولی CDN می‌تواند تا یک روز کهنه سرو کند
# و پس‌زمینه تازه‌اش کند — یعنی بازدید بعدی همیشه از لبه و سریع است
/
  Cache-Control: public, max-age=600, s-maxage=86400, stale-while-revalidate=604800

/index.html
  Cache-Control: public, max-age=600, s-maxage=86400, stale-while-revalidate=604800

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
